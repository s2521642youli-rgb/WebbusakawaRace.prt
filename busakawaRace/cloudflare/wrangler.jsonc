{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "busakawa-voting",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-17",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none"},
  "durable_objects": {"bindings": [{"name": "RACE_ROOM", "class_name": "RaceRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RaceRoom"]}],
  "vars": {"ALLOWED_ORIGINS": "http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:8767"},
  "observability": {"enabled": false}
}
